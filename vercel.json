{
    "builds": [
        {
            "src": "frontend/package.json",
            "use": "@vercel/static-build"
        },
        {
            "src": "main.py",
            "use": "@vercel/python"
        }
    ],
    "routes": [
        {
            "src": "/api/divination",
            "dest": "https://ai-divination-tools.vercel.app/api/divination"
        },
        {
            "src": "/api/(.*)",
            "dest": "main.py"
        },
        {
            "src": "/docs",
            "dest": "main.py"
        },
        {
            "src": "/openapi.json",
            "dest": "main.py"
        },
        {
            "src": "/divination",
            "dest": "https://ai-divination-tools.vercel.app/divination"
        },
        {
            "src": "/divination/(.*)",
            "dest": "https://ai-divination-tools.vercel.app/divination/$1"
        },
        {
            "src": "/pdf",
            "dest": "https://pdf-tools-five-chi.vercel.app/"
        },
        {
            "src": "/pdf/(.*)",
            "dest": "https://pdf-tools-five-chi.vercel.app/$1"
        },
        {
            "src": "/image",
            "status": 308,
            "headers": {
                "Cross-Origin-Embedder-Policy": "require-corp",
                "Cross-Origin-Opener-Policy": "same-origin"
            }
        },
        {
            "src": "/image/(.*)",
            "dest": "https://sharp-web-tools.vercel.app/$1",
            "headers": {
                "Cross-Origin-Embedder-Policy": "require-corp",
                "Cross-Origin-Opener-Policy": "same-origin"
            }
        },
        {
            "src": "/developer",
            "dest": "https://dev-tools-blue.vercel.app/"
        },
        {
            "src": "/developer/(.*)",
            "dest": "https://dev-tools-blue.vercel.app/$1"
        },
        {
            "src": "/seo",
            "dest": "https://seo-tools-project-production.up.railway.app/check"
        },
        {
            "src": "/seo/",
            "dest": "https://seo-tools-project-production.up.railway.app/check"
        },
        {
            "src": "/website-inspection",
            "dest": "/frontend/website-inspection.html"
        },
        {
            "src": "/compress-pdf-to-2mb",
            "dest": "/frontend/compress-pdf-to-2mb.html"
        },
        {
            "src": "/about",
            "dest": "/frontend/about.html"
        },
        {
            "src": "/zh",
            "dest": "/frontend/zh/index.html"
        },
        {
            "src": "/zh/",
            "dest": "/frontend/zh/index.html"
        },
        {
            "src": "/en",
            "status": 308,
            "headers": {
                "Location": "/"
            }
        },
        {
            "src": "/en/",
            "status": 308,
            "headers": {
                "Location": "/"
            }
        },
        {
            "src": "/zh/guides",
            "dest": "/frontend/guides/index.html",
            "headers": {
                "X-Robots-Tag": "noindex, follow"
            }
        },
        {
            "src": "/guides",
            "dest": "/frontend/guides/index.html"
        },
        {
            "src": "/guides/",
            "dest": "/frontend/guides/index.html"
        },
        {
            "src": "/privacy",
            "dest": "/frontend/privacy.html"
        },
        {
            "src": "/terms",
            "dest": "/frontend/terms.html"
        },
        {
            "src": "/changelog",
            "dest": "/frontend/changelog.html"
        },
        {
            "src": "/zh/pdf",
            "dest": "/frontend/pdf-tools.html",
            "headers": {
                "X-Robots-Tag": "noindex, follow"
            }
        },
        {
            "src": "/zh/guides/merge-pdf",
            "dest": "/frontend/guides/merge-pdf.html",
            "headers": {
                "X-Robots-Tag": "noindex, follow"
            }
        },
        {
            "src": "/zh/guides/compress-pdf",
            "dest": "/frontend/guides/compress-pdf.html",
            "headers": {
                "X-Robots-Tag": "noindex, follow"
            }
        },
        {
            "src": "/zh/guides/compress-image",
            "dest": "/frontend/guides/compress-image.html",
            "headers": {
                "X-Robots-Tag": "noindex, follow"
            }
        },
        {
            "src": "/seo/(.*)",
            "dest": "https://seo-tools-project-production.up.railway.app/check/$1"
        },
        {
            "src": "/seo-api/(.*)",
            "dest": "https://seo-tools-project-production.up.railway.app/api/$1"
        },
        {
            "src": "/_astro/(.*)",
            "dest": "https://seo-tools-project-production.up.railway.app/_astro/$1"
        },
        {
            "src": "/fonts/(.*)",
            "dest": "https://seo-tools-project-production.up.railway.app/fonts/$1"
        },
        {
            "src": "/(.*)\\.(.*)",
            "dest": "/frontend/$1.$2"
        },
        {
            "src": "/",
            "dest": "frontend/"
        },
        {
            "src": "/subscription",
            "dest": "frontend/",
            "headers": {
                "X-Robots-Tag": "noindex, nofollow"
            }
        },
        {
            "src": "/account",
            "dest": "frontend/",
            "headers": {
                "X-Robots-Tag": "noindex, nofollow"
            }
        },
        {
            "src": "/portrait",
            "dest": "frontend/",
            "headers": {
                "X-Robots-Tag": "noindex, nofollow"
            }
        },
        {
            "src": "/auth/(.*)",
            "dest": "frontend/",
            "headers": {
                "X-Robots-Tag": "noindex, nofollow"
            }
        },
        {
            "src": "/(.*)",
            "dest": "/frontend/404.html",
            "status": 404
        }
    ]
}
