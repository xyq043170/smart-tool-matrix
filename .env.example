# Required: Neon pooled PostgreSQL connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Required: AI model
API_KEY=
API_BASE=https://api.openai.com/v1
MODEL=gpt-4.1-mini

# Required in production: keep stable or existing login tokens and guest identities change
JWT_SECRET=

# Daily quota
DAILY_FREE_LIMIT_GUEST=3
DAILY_FREE_LIMIT_USER=5
DAILY_QUOTA_TIMEZONE=Asia/Shanghai

# Image generation
IMAGE_API_KEY=
IMAGE_API_BASE=https://www.packyapi.com/v1
IMAGE_MODEL=gemini-3.1-flash-image-preview
IMAGE_QUALITY=high
IMAGE_OUTPUT_FORMAT=png

# PayPal one-time payments and automatic subscriptions
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=
PAYPAL_PLAN_DAILY=
PAYPAL_PLAN_WEEKLY=
PAYPAL_PLAN_MONTHLY=
PAYPAL_PLAN_YEARLY=

# Login providers
GOOGLE_CLIENT_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Transactional email
RESEND_API_KEY=
EMAIL_FROM=Smart Tool Matrix <noreply@your-verified-domain.com>
APP_URL=http://localhost:5173

# Optional generic anti-abuse cache (billing quota is always stored in PostgreSQL)
CACHE_CLIENT_TYPE=memory
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional UI settings
DEFAULT_API_BASE=https://api.openai.com/v1
DEFAULT_MODEL=gpt-4.1-mini
ENABLE_RATE_LIMIT=true
PURCHASE_URL=
AD_CLIENT=
AD_SLOT=
